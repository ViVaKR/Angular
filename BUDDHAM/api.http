Content-Type: application/json
Authorization: Bearer {{vivToken}}

{
  "id": "{{tempId}}",
  "roles": ["Admin", "User", "Editor", "Dev"]
}

### * 토큰 갱신
POST {{HOST}}/Auth/RefreshToken
Content-Type: application/json
Authorization: Bearer {{vivToken}}

{
  "accessToken": "{{vivToken}}",
  "refreshToken": "{{vivRefreshToken}}"
}

